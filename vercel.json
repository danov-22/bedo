{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/app-config.js",
      "destination": "/Bedo-site/app-config.js"
    },
    {
      "source": "/storage-migration.js",
      "destination": "/Bedo-site/storage-migration.js"
    },
    {
      "source": "/bedo-app.js",
      "destination": "/Bedo-site/bedo-app.js"
    },
    {
      "source": "/bedo-app.css",
      "destination": "/Bedo-site/bedo-app.css"
    },
    {
      "source": "/",
      "destination": "/Bedo-site/index.html"
    },
    {
      "source": "/bedo-sync.js",
      "destination": "/Bedo-site/bedo-sync.js"
    },
    {
      "source": "/bedo-auth.js",
      "destination": "/Bedo-site/bedo-auth.js"
    },
    {
      "source": "/auth-config.js",
      "destination": "/Bedo-site/auth-config.js"
    },
    {
      "source": "/service-worker.js",
      "destination": "/Bedo-site/service-worker.js"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/Bedo-site/manifest.webmanifest"
    },
    {
      "source": "/favicon.svg",
      "destination": "/Bedo-site/favicon.svg"
    },
    {
      "source": "/robots.txt",
      "destination": "/Bedo-site/robots.txt"
    },
    {
      "source": "/:path*",
      "destination": "/Bedo-site/index.html"
    }
  ]
}
